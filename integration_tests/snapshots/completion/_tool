#compdef tool
# tool zsh completion (auto-generated)

_tool() {
    local cur prev path i value_prefix
    cur="${words[CURRENT]}"
    prev="${words[CURRENT-1]}"

    path=""
    for (( i=2; i<CURRENT; i++ )); do
        case "${words[i]}" in
            --color)
                (( i++ ))
                ;;

            --name|--target-name)
                (( i++ ))
                ;;

            --format|-f)
                (( i++ ))
                ;;

            --rate)
                (( i++ ))
                ;;

            --interval)
                (( i++ ))
                ;;

            --config)
                (( i++ ))
                ;;

            --tag)
                (( i++ ))
                ;;

            --host)
                (( i++ ))
                ;;

            -*) ;;
            *)
                if [[ -z "$path" ]]; then
                    path="${words[i]}"
                else
                    path="$path ${words[i]}"
                fi
                ;;
        esac
    done
    case "$path" in
        "")
            case "$cur" in
                --color=*)
                    value_prefix="${cur#*=}"
                    compset -P "${cur%%=*}="
                    _values 'values' "auto" "always" "never"; return ;;
            esac
            case "$prev" in
                --color)
                    _values 'values' "auto" "always" "never"; return ;;
            esac
            ;;
        "run")
            case "$cur" in
                --color=*)
                    value_prefix="${cur#*=}"
                    compset -P "${cur%%=*}="
                    _values 'values' "auto" "always" "never"; return ;;
                --format=*)
                    value_prefix="${cur#*=}"
                    compset -P "${cur%%=*}="
                    _values 'values' "json" "text" "yaml"; return ;;
                -f*)
                    value_prefix="${cur[3,-1]}"
                    compset -P "-f"
                    _values 'values' "json" "text" "yaml"; return ;;
                --config=*)
                    value_prefix="${cur#*=}"
                    compset -P "${cur%%=*}="
                    _files; return ;;
                --host=*)
                    value_prefix="${cur#*=}"
                    compset -P "${cur%%=*}="
                    compadd -- ${(f)"$("$words[1]" __complete --host "$value_prefix")"}; return ;;
            esac
            case "$prev" in
                --color)
                    _values 'values' "auto" "always" "never"; return ;;
                --format|-f)
                    _values 'values' "json" "text" "yaml"; return ;;
                --config)
                    _files; return ;;
                --host)
                    compadd -- ${(f)"$("$words[1]" __complete --host "$cur")"}; return ;;
            esac
            ;;
    esac

    local -a cmds flags values
    case "$path" in
        "")
            cmds=("run:Run target")
            flags=("--verbose:Verbose output" "-v:Verbose output" "--debug:Increase debug verbosity (repeatable)" "-d:Increase debug verbosity (repeatable)" "--color:When to colorize output" "--help:Show help" "-h:Show help")
            values=()
            ;;
        "run")
            cmds=()
            flags=("--verbose:Verbose output" "-v:Verbose output" "--debug:Increase debug verbosity (repeatable)" "-d:Increase debug verbosity (repeatable)" "--color:When to colorize output" "--name:Target name" "--format:Output format" "-f:Output format" "--rate:Sampling rate" "--interval:Poll interval" "--config:Config file path" "--tag:Repeatable tag" "--host:Target host (dynamic)" "--help:Show help" "-h:Show help")
            values=()
            ;;
    esac

    if [[ "$cur" == -* ]]; then
        _describe -t flags 'flags' flags
    else
        if (( ${#cmds} )); then
            _describe -t commands 'commands' cmds
        else
            _describe -t values 'values' values
        fi
    fi
}

_tool "$@"
